<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<LangVersion>preview</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<AssemblyName>CommandItemQueue</AssemblyName>
		<RootNamespace>CommandItemQueue</RootNamespace>
		<Version>1.1.0</Version>
		<DebugType>embedded</DebugType>
		<Nullable>disable</Nullable>
	</PropertyGroup>

	<!-- Test install into the mod manager profile is handled by C:\Users\Pascal\source\repos\Directory.Build.targets (profile "TestMods"). -->
	<PropertyGroup>
		<ThunderstoreDir>$(MSBuildProjectDirectory)\..\Thunderstore\</ThunderstoreDir>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BepInEx.Analyzers" Version="1.0.*">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>

		<!-- BepInEx.Core already brings HarmonyX (0Harmony), which ships with every BepInExPack. No R2API needed. -->
		<PackageReference Include="BepInEx.Core" Version="5.4.21" />

		<PackageReference Include="UnityEngine.Modules" Version="2021.3.33" IncludeAssets="compile" />
		<PackageReference Include="RiskOfRain2.GameLibs" Version="1.3.6-r.0" />
	</ItemGroup>

	<Target Name="CopyToThunderstoreAndProfile" AfterTargets="Build">
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ThunderstoreDir)plugins\$(AssemblyName)\" />
	</Target>

	<!-- Release build: also creates the upload-ready Thunderstore zip in ..\dist\ -->
	<Target Name="PackThunderstore" AfterTargets="CopyToThunderstoreAndProfile" Condition="'$(Configuration)' == 'Release'">
		<MakeDir Directories="$(MSBuildProjectDirectory)\..\dist" />
		<ZipDirectory SourceDirectory="$(ThunderstoreDir)" DestinationFile="$(MSBuildProjectDirectory)\..\dist\AllOfThem-$(AssemblyName)-$(Version).zip" Overwrite="true" />
		<Message Importance="high" Text="Thunderstore package: dist\AllOfThem-$(AssemblyName)-$(Version).zip" />
	</Target>

</Project>
